@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global chart variables to prevent multiple instances
        let attendanceChart = null;
        let projectChart = null;
        let chartsInitialized = false;

        $(document).ready(function() {
            if (!chartsInitialized) {
                initializeCharts();
                chartsInitialized = true;
            }
        });

        // Remove all demo loaders and use server-rendered values only

        function initializeCharts() {
            // Destroy existing charts completely before creating new ones
            destroyCharts();

            // Wait for DOM to be fully ready
            setTimeout(() => {
                // Attendance Chart
                const attendanceCanvas = document.getElementById('attendanceChart');
                if (attendanceCanvas && !attendanceChart) {
                    const attendanceCtx = attendanceCanvas.getContext('2d');
                    attendanceChart = new Chart(attendanceCtx, {
                        type: 'line',
                        data: {
                            labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((IEnumerable<string>)ViewBag.WeeklyLabels ?? Array.Empty<string>())),
                            datasets: [{
                                label: 'Attendance %',
                                data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((IEnumerable<double>)ViewBag.WeeklyPercentages ?? Array.Empty<double>())),
                                borderColor: 'rgb(75, 192, 192)',
                                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                tension: 0.4,
                                fill: true
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                intersect: false,
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    max: 100
                                }
                            },
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top'
                                }
                            }
                        }
                    });
                }

                // Project Status Chart
                const projectCanvas = document.getElementById('projectChart');
                if (projectCanvas && !projectChart) {
                    const projectCtx = projectCanvas.getContext('2d');
                    projectChart = new Chart(projectCtx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Active', 'Completed', 'Planning', 'On Hold'],
                            datasets: [{
                                data: [45, 30, 20, 5],
                                backgroundColor: [
                                    'rgb(54, 162, 235)',
                                    'rgb(75, 192, 192)',
                                    'rgb(255, 205, 86)',
                                    'rgb(255, 99, 132)'
                                ],
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        padding: 20,
                                        usePointStyle: true
                                    }
                                }
                            }
                        }
                    });
                }
            }, 100);
        }

        function destroyCharts() {
            if (attendanceChart) {
                attendanceChart.destroy();
                attendanceChart = null;
            }
            if (projectChart) {
                projectChart.destroy();
                projectChart = null;
            }
        }

        function filterActivities(type) {
            $('.btn-group .btn').removeClass('active');
            event.target.classList.add('active');
            
            if (type === 'all') {
                $('.activity-item').show();
            } else {
                $('.activity-item').hide();
                $(`.activity-item[data-type="${type}"]`).show();
            }
        }

        // Cleanup charts when page is unloaded
        $(window).on('beforeunload', function() {
            destroyCharts();
        });

        // Prevent multiple chart initializations on window resize
        let resizeTimeout;
        $(window).on('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function() {
                if (attendanceChart) {
                    attendanceChart.resize();
                }
                if (projectChart) {
                    projectChart.resize();
                }
            }, 250);
        });
    </script>
}
