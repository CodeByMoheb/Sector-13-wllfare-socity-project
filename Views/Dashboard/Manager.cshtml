@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h2 class="card-title">
                        <i class="fas fa-user-cog me-2"></i>
                        Manager Dashboard
                    </h2>
                    <p class="card-text">Welcome, @ViewBag.UserName! You are responsible for managing society operations.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Management Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient-primary text-white py-3 border-0">
                    <h5 class="mb-0">
                        <i class="fas fa-user-clock me-2"></i>
                        Employee Attendance Management
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a href="@Url.Action("Manage", "Attendance")" class="btn btn-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                                <i class="fas fa-calendar-day fa-2x mb-2"></i>
                                <span class="fw-bold">Daily Attendance</span>
                                <small class="text-muted">View and manage today's attendance</small>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("AllRecords", "Attendance")" class="btn btn-info w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                                <i class="fas fa-list fa-2x mb-2"></i>
                                <span class="fw-bold">All Records</span>
                                <small class="text-muted">Browse complete attendance history</small>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("Report", "Attendance")" class="btn btn-success w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                                <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                <span class="fw-bold">Reports</span>
                                <small class="text-muted">Generate attendance reports</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Management Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient-success text-white py-3 border-0">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-check me-2"></i>
                        Leave Request Management
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="@Url.Action("Index", "LeaveApproval")" class="btn btn-success w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                                <i class="fas fa-clock fa-2x mb-2"></i>
                                <span class="fw-bold">Leave Approvals</span>
                                <small class="text-muted">Approve or reject leave requests</small>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="@Url.Action("AllLeaves", "LeaveApproval")" class="btn btn-warning w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                <span class="fw-bold">All Leave Requests</span>
                                <small class="text-muted">View complete leave history</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

  </div> 

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .bg-gradient-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    }
    
    .btn {
        transition: all 0.3s ease;
        border-radius: 12px;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    
    .list-group-item {
        transition: all 0.3s ease;
        border-radius: 8px;
        margin-bottom: 5px;
    }
    
    .list-group-item:hover {
        background-color: #f8f9fa;
        transform: translateX(5px);
    }
</style> 
