@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-lock text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="card-title text-danger">Access Denied</h2>
                    <p class="card-text text-muted mb-4">
                        You don't have permission to access this page.
                    </p>
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        <p class="small text-muted">
                            You are currently logged in as: <strong>@User.Identity.Name</strong>
                        </p>
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                                <i class="fas fa-home"></i> Go to Home
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fas fa-home"></i> Go to Home
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
