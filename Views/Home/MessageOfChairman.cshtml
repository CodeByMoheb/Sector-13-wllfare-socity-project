@model IEnumerable<Sector_13_Welfare_Society___Digital_Management_System.Models.LeadershipMessage>
@{
    ViewData["Title"] = "Message of Chairman";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #f8f9fa;
        margin: 0;
        padding: 0;
    }

    .section-header {
        text-align: center;
        margin: 60px 0 30px;
    }

    .section-header h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .section-header p {
        font-size: 1.1rem;
        color: #7f8c8d;
        max-width: 600px;
        margin: 0 auto;
    }

    .chairman-content {
        max-width: 520px;
        margin: 40px auto 60px auto;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(44, 62, 80, 0.06);
        padding: 32px 32px 28px 32px;
    }

    .chairman-content h3 {
        color: #2563eb;
        font-size: 1.18rem;
        font-weight: 700;
        margin-bottom: 18px;
        margin-top: 28px;
    }

    .chairman-content h3:first-child {
        margin-top: 0;
    }

    .chairman-content p {
        font-size: 1.01rem;
        color: #222;
        margin-bottom: 12px;
        line-height: 1.6;
    }

    .chairman-signature {
        margin-top: 30px;
        font-style: italic;
        color: #2563eb;
    }

    /* Hero Section */
    .hero-section {
        background-image: url("https://res.cloudinary.com/ddl4hnmnz/image/upload/v1752642542/background_jomopz.gif");
        color: #fff;
        padding: 40px 20px 28px 20px;
        text-align: center;
        width: 100%;
        box-sizing: border-box;
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: 1.08rem;
        margin-bottom: 0;
        line-height: 1.5;
    }

    /* Chairman Intro Section */
    .chairman-intro {
        background: #fafbfc;
        padding: 36px 20px 25px 20px;
        box-sizing: border-box;
    }

    .chairman-container {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        gap: 40px;
        flex-wrap: wrap;
    }

    .chairman-photo-section {
        flex: 0 0 220px;
        text-align: center;
    }

    .chairman-photo {
        width: 270px;
        height: 300px;
        object-fit: cover;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 12px;
    }

    .chairman-name {
        font-weight: 700;
        color: #2563eb;
        font-size: 1.15rem;
        line-height: 1.3;
    }

    .chairman-title {
        font-size: 0.98rem;
        color: #222;
        line-height: 1.4;
    }

    .message-intro {
        flex: 1 1 350px;
        min-width: 280px;
        text-align: left;
    }

    .quote-icon {
        font-size: 2.2rem;
        color: #4072b7;
        margin-bottom: 8px;
    }

    .greeting {
        font-weight: 600;
        color: #2563eb;
        margin-bottom: 6px;
    }

    .intro-text {
        font-size: 1.04rem;
        color: #222;
        line-height: 1.6;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 1.8rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .chairman-container {
            flex-direction: column;
            gap: 30px;
        }

        .chairman-photo-section {
            flex: none;
            width: 100%;
        }

        .chairman-photo {
            width: 220px;
            height: 250px;
        }

        .message-intro {
            flex: none;
            width: 100%;
            min-width: auto;
        }

        .quote-icon {
            font-size: 1.8rem;
        }

        .chairman-content {
            margin: 30px 15px 50px 15px;
            padding: 25px 20px 20px 20px;
        }

        .chairman-content h3 {
            font-size: 1.1rem;
        }

        .chairman-content p {
            font-size: 0.95rem;
        }
    }

    @@media (max-width: 480px) {
        .hero-section {
            padding: 30px 15px 25px 15px;

        }

        .hero-title {
            font-size: 1.5rem;
        }

        .hero-subtitle {
            font-size: 0.9rem;
        }

        .chairman-intro {
            padding: 25px 15px 15px 15px;
        }

        .chairman-photo {
            width: 180px;
            height: 200px;
        }

        .chairman-name {
            font-size: 1rem;
        }

        .chairman-title {
            font-size: 0.9rem;
        }

        .quote-icon {
            font-size: 1.5rem;
        }

        .greeting {
            font-size: 0.95rem;
        }

        .intro-text {
            font-size: 0.95rem;
        }

        .chairman-content {
            margin: 25px 10px 40px 10px;
            padding: 20px 15px 15px 15px;
        }

        .chairman-content h3 {
            font-size: 1rem;
            margin-bottom: 15px;
            margin-top: 25px;
        }

        .chairman-content p {
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .chairman-signature {
            margin-top: 25px;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 360px) {
        .hero-title {
            font-size: 1.3rem;
        }

        .hero-subtitle {
            font-size: 0.85rem;
        }

        .chairman-photo {
            width: 150px;
            height: 170px;
        }

        .chairman-name {
            font-size: 0.9rem;
        }

        .chairman-title {
            font-size: 0.8rem;
        }

        .quote-icon {
            font-size: 1.3rem;
        }

        .greeting {
            font-size: 0.9rem;
        }

        .intro-text {
            font-size: 0.9rem;
        }

        .chairman-content {
            margin: 20px 8px 35px 8px;
            padding: 18px 12px 12px 12px;
        }

        .chairman-content h3 {
            font-size: 0.95rem;
        }

        .chairman-content p {
            font-size: 0.85rem;
        }

        .chairman-signature {
            font-size: 0.85rem;
        }
    }

    /* Tablet specific adjustments */
    @@media (min-width: 769px) and (max-width: 1024px) {
        .chairman-container {
            gap: 30px;
        }

        .chairman-photo {
            width: 240px;
            height: 270px;
        }

        .chairman-content {
            max-width: 600px;
            margin: 35px auto 55px auto;
            padding: 30px 30px 25px 30px;
        }
    }

    /* Large screen adjustments */
    @@media (min-width: 1200px) {
        .chairman-content {
            max-width: 600px;
        }

        .hero-title {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.15rem;
        }
    }
</style>

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Message from the President</h1>
        <p class="hero-subtitle">A personal reflection on our mission, values, and commitment to<br />serving
            Bangladesh's most vulnerable communities.</p>
    </div>
</section>

@if (Model != null && Model.Any())
{
    @foreach (var message in Model)
    {
        <section class="chairman-intro">
            <div class="chairman-container">
                <!-- Left: Chairman Photo and Name -->
                <div class="chairman-photo-section">
                    @if (!string.IsNullOrEmpty(message.ImageUrl))
                    {
                        <img src="@message.ImageUrl" alt="@message.Name" class="chairman-photo" />
                    }
                    else
                    {
                        <img src="https://res.cloudinary.com/ddl4hnmnz/image/upload/v1752641792/pp_oigmrs.png" alt="@message.Name" class="chairman-photo" />
                    }
                    <div class="chairman-name">@message.Name</div>
                    <div class="chairman-title">
                        <b class="text-success">@message.Designation</b>
                        <br />Sector 13 Welfare Society
                    </div>
                </div>
                <!-- Right: Message Intro -->
                <div class="message-intro">
                    <div class="quote-icon"><i class="fas fa-quote-left"></i></div>
                    <div class="greeting">Assalamu Alaikum and warm greetings,</div>
                    <div class="intro-text">
                        @Html.Raw(message.Message.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>
        </section>
        
        @if (message != Model.Last())
        {
            <hr>
        }
    }
}
else
{
    <!-- Fallback content if no dynamic data is available -->
    <section class="chairman-intro">
        <div class="chairman-container">
            <div class="chairman-photo-section">
                <img src="https://res.cloudinary.com/ddl4hnmnz/image/upload/v1752641792/pp_oigmrs.png"
                    alt="Brig Gen Md Zahid Hossain, PhD (Retd)" class="chairman-photo" />
                <div class="chairman-name">Brig Gen Md Zahid Hossain, PhD (Retd)</div>
                <div class="chairman-title"> <b class="text-success">President</b>
                    <br />Sector 13 Welfare Society
                </div>
            </div>
            <div class="message-intro">
                <div class="quote-icon"><i class="fas fa-quote-left"></i></div>
                <div class="greeting">Assalamu Alaikum and warm greetings,</div>
                <div class="intro-text">
                    সেক্টর ১৩ ওয়েলফেয়ার সোসাইটির সভাপতি হিসেবে দায়িত্ব পালন করা আমার জন্য এক গর্বের বিষয় এবং একটি মহান
                    দায়িত্বও বটে।
                    আমাদের লক্ষ্য হলো একটি নিরাপদ, পরিচ্ছন্ন, সুপরিকল্পিত ও মানবিক সমাজ গঠন করা—যেখানে সকলে সম্মিলিতভাবে
                    বসবাস করবেন এবং আধুনিক নাগরিক সুযোগ-সুবিধা উপভোগ করবেন। স্বচ্ছতা, স্বেচ্ছাসেবা ও সক্রিয় অংশগ্রহণের
                    মাধ্যমে আমরা অংশগ্রহণমূলক উন্নয়নে বিশ্বাস করি।
                    সেক্টর ১৩ একটি সচেতন ও সংগঠিত সমাজের প্রতিচ্ছবি, যা অন্যদের জন্য অনুকরণীয় হতে পারে। ঐক্য, সহমর্মিতা ও
                    উদ্ভাবনের মাধ্যমে আমরা একটি উদাহরণ স্থাপন করতে পারি—এটি আমাদের বিশ্বাস।
                    আসুন, আমরা সবাই মিলে সততা ও সম্মানের ভিত্তিতে একটি আদর্শ সমাজ গড়ে তুলি, যা গোটা দেশের জন্য অনুপ্রেরণার
                    উৎস হবে। <br>

                    <span style="font-style: italic; color: #6a4bbf;"> শুভেচ্ছান্তে, <br>
                        ব্রিগেডিয়ার জেনারেল মোঃ জাহিদ হোসেন, পিএইচ.ডি (অব.)
                    </span> <br>

                    <b> সভাপতি, 
                        সেক্টর ১৩ ওয়েলফেয়ার সোসাইটি </b>
                </div>
            </div>
        </div>
    </section>
}