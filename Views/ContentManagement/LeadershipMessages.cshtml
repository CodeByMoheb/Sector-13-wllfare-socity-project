@model IEnumerable<Sector_13_Welfare_Society___Digital_Management_System.Models.LeadershipMessage>
@{
    ViewData["Title"] = "Leadership Messages Management";
    Layout = "_DashboardLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users me-2"></i>Leadership Messages Management</h2>
        <a class="btn btn-primary" href="@Url.Action("CreateLeadershipMessage")">
            <i class="fas fa-plus me-2"></i>Add New Message
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No leadership messages found.</strong> Create your first message to get started.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var message in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(message.ImageUrl))
                        {
                            <img src="@message.ImageUrl" class="card-img-top" alt="@message.Name" style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@message.Name</h5>
                            <p class="card-text text-muted">@message.Designation</p>
                            <p class="card-text">
                                @if (message.Message.Length > 100)
                                {
                                    @(message.Message.Substring(0, 100) + "...")
                                }
                                else
                                {
                                    @message.Message
                                }
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-tag me-1"></i>@message.MessageType
                                    </small>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("EditLeadershipMessage", new { id = message.Id })" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="@Url.Action("DeleteLeadershipMessage", new { id = message.Id })" 
                                              onsubmit="return confirm('Are you sure you want to delete this message?')" 
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
