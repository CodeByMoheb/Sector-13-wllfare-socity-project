@model Sector_13_Welfare_Society___Digital_Management_System.Models.PreviousCandidate
@{
    ViewData["Title"] = "Create Previous Candidate";
    Layout = "_DashboardLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-plus me-2"></i>Create Previous Candidate</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreatePreviousCandidate" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Name *</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Designation" class="form-label">Designation *</label>
                                <input asp-for="Designation" class="form-control" placeholder="e.g., President, Secretary" />
                                <span asp-validation-for="Designation" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="TermPeriod" class="form-label">Term Period *</label>
                                <input asp-for="TermPeriod" class="form-control" placeholder="e.g., 2016-2017" />
                                <span asp-validation-for="TermPeriod" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="imageFile" class="form-label">Upload Photo</label>
                            <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" />
                            <div class="form-text">Upload a photo of the person (JPG, PNG, GIF)</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                                <div class="form-text">Lower numbers appear first</div>
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="IsPresident" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsPresident" class="form-check-label">
                                        Is President
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Active
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("PreviousCandidates")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Create Candidate
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
