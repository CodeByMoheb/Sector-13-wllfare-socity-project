@model IEnumerable<Sector_13_Welfare_Society___Digital_Management_System.Models.PreviousCandidate>
@{
    ViewData["Title"] = "Previous Candidates Management";
    Layout = "_DashboardLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-history me-2"></i>Previous Candidates Management</h2>
        <a class="btn btn-primary" href="@Url.Action("CreatePreviousCandidate")">
            <i class="fas fa-plus me-2"></i>Add New Candidate
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No previous candidates found.</strong> Create your first candidate to get started.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var candidate in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(candidate.ImageUrl))
                        {
                            <img src="@candidate.ImageUrl" class="card-img-top" alt="@candidate.Name" style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@candidate.Name</h5>
                            <p class="card-text text-muted">@candidate.Designation</p>
                            @if (!string.IsNullOrEmpty(candidate.Phone))
                            {
                                <p class="card-text"><i class="fas fa-phone me-1"></i>@candidate.Phone</p>
                            }
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>@candidate.TermPeriod
                                        @if (candidate.IsPresident)
                                        {
                                            <span class="badge bg-primary ms-2">President</span>
                                        }
                                    </small>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("EditPreviousCandidate", new { id = candidate.Id })" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="@Url.Action("DeletePreviousCandidate", new { id = candidate.Id })" 
                                              onsubmit="return confirm('Are you sure you want to delete this candidate?')" 
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
