@model IEnumerable<Sector_13_Welfare_Society___Digital_Management_System.Models.Attendance>
@{
    ViewData["Title"] = "Attendance Management";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-gradient-primary text-white mb-4 border-0 shadow-lg">
                <div class="card-body">
                    <h2 class="card-title">
                        <i class="fas fa-user-clock me-3"></i>
                        Attendance Management
                    </h2>
                    <p class="card-text">Monitor and manage employee attendance for @ViewBag.Date.ToString("dddd, dd MMMM yyyy")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label for="date" class="form-label">Date</label>
                            <input type="date" class="form-control" id="date" name="date" value="@ViewBag.Date.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label for="employeeId" class="form-label">Employee</label>
                            <select class="form-select" id="employeeId" name="employeeId">
                                <option value="">All Employees</option>
                                @foreach (var emp in ViewBag.Employees)
                                {
                                    if (ViewBag.SelectedEmployeeId == emp.Id)
                                    {
                                        <option value="@emp.Id" selected>@emp.Name (@emp.EmployeeId)</option>
                                    }
                                    else
                                    {
                                        <option value="@emp.Id">@emp.Name (@emp.EmployeeId)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="status" class="form-label">Status</label>
                            <select class="form-select" id="status" name="status">
                                <option value="">All Status</option>
                                @if (ViewBag.SelectedStatus == "Present")
                                {
                                    <option value="Present" selected>Present</option>
                                }
                                else
                                {
                                    <option value="Present">Present</option>
                                }
                                @if (ViewBag.SelectedStatus == "Absent")
                                {
                                    <option value="Absent" selected>Absent</option>
                                }
                                else
                                {
                                    <option value="Absent">Absent</option>
                                }
                                @if (ViewBag.SelectedStatus == "Late")
                                {
                                    <option value="Late" selected>Late</option>
                                }
                                else
                                {
                                    <option value="Late">Late</option>
                                }
                                @if (ViewBag.SelectedStatus == "On-time")
                                {
                                    <option value="On-time" selected>On-time</option>
                                }
                                else
                                {
                                    <option value="On-time">On-time</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search me-2"></i>Filter
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Summary -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-gradient-success text-white">
                <div class="card-body text-center">
                    <i class="fas fa-check-circle fa-2x mb-2"></i>
                    <h4>@Model.Count(a => a.Status == "Present" || a.Status == "On-time")</h4>
                    <p class="mb-0">Present</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-gradient-warning text-white">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x mb-2"></i>
                    <h4>@Model.Count(a => a.Status == "Late")</h4>
                    <p class="mb-0">Late</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-gradient-danger text-white">
                <div class="card-body text-center">
                    <i class="fas fa-times-circle fa-2x mb-2"></i>
                    <h4>@Model.Count(a => a.Status == "Absent")</h4>
                    <p class="mb-0">Absent</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-gradient-info text-white">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <h4>@Model.Count()</h4>
                    <p class="mb-0">Total</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient-info text-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-table me-2"></i>
                            Attendance Records
                        </h5>
                        <div>
                            <a href="@Url.Action("AllRecords")" class="btn btn-light btn-sm">
                                <i class="fas fa-list me-1"></i>View All Records
                            </a>
                            <a href="@Url.Action("Report")" class="btn btn-light btn-sm">
                                <i class="fas fa-chart-bar me-1"></i>Reports
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Shift</th>
                                        <th>Check In</th>
                                        <th>Check Out</th>
                                        <th>Total Hours</th>
                                        <th>Status</th>
                                        <th>Location</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attendance in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-3">
                                                        <i class="fas fa-user-circle fa-2x text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@attendance.Employee.Name</strong>
                                                        <br>
                                                        <small class="text-muted">@attendance.Employee.EmployeeId</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (attendance.Employee.Shift != null)
                                                {
                                                    <span class="badge bg-info">
                                                        @attendance.Employee.Shift.Name
                                                    </span>
                                                    <br>
                                                    <small class="text-muted">
                                                        @attendance.Employee.Shift.StartTime.ToString("HH:mm") - 
                                                        @attendance.Employee.Shift.EndTime.ToString("HH:mm")
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No shift assigned</span>
                                                }
                                            </td>
                                            <td>
                                                @if (attendance.CheckInTime.HasValue)
                                                {
                                                    <span class="text-success">
                                                        <i class="fas fa-check-circle me-1"></i>
                                                        @attendance.CheckInTime.Value.ToString("HH:mm:ss")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        Not checked in
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (attendance.CheckOutTime.HasValue)
                                                {
                                                    <span class="text-danger">
                                                        <i class="fas fa-sign-out-alt me-1"></i>
                                                        @attendance.CheckOutTime.Value.ToString("HH:mm:ss")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        Not checked out
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (attendance.TotalHours.HasValue)
                                                {
                                                    <span class="badge bg-secondary">
                                                        @attendance.TotalHours.Value.ToString("F2") hrs
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var statusClass = attendance.Status switch
                                                    {
                                                        "Present" or "On-time" => "bg-success",
                                                        "Late" => "bg-warning",
                                                        "Absent" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @statusClass">
                                                    @attendance.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(attendance.Location))
                                                {
                                                    <small class="text-muted">
                                                        <i class="fas fa-map-marker-alt me-1"></i>
                                                        @attendance.Location
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-outline-primary btn-sm edit-status-btn"
                                                            data-attendance-id="@attendance.AttendanceId"
                                                            data-current-status="@attendance.Status"
                                                            data-employee-name="@attendance.Employee.Name">
                                                        <i class="fas fa-edit me-1"></i>Edit
                                                    </button>
                                                    <a href="@Url.Action("EmployeeReport", new { employeeId = attendance.EmployeeId })" 
                                                       class="btn btn-outline-info btn-sm">
                                                        <i class="fas fa-chart-line me-1"></i>Report
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Attendance Records</h5>
                            <p class="text-muted">No attendance records found for the selected criteria.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Status Modal -->
<div class="modal fade" id="editStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Attendance Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="editStatusModalBody">Update the attendance status for this employee.</p>
                <div class="mb-3">
                    <label for="newStatus" class="form-label">Status</label>
                    <select class="form-select" id="newStatus">
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Late">Late</option>
                        <option value="On-time">On-time</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="remarks" class="form-label">Remarks (Optional)</label>
                    <textarea class="form-control" id="remarks" rows="3" placeholder="Add any remarks..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmEditStatus">Update</button>
            </div>
        </div>
    </div>
    <input type="hidden" id="currentAttendanceId" />
</div>

@section Scripts {
    <script>
        $(function () {
            // Edit status button click
            $('.edit-status-btn').on('click', function () {
                const attendanceId = $(this).data('attendance-id');
                const currentStatus = $(this).data('current-status');
                const employeeName = $(this).data('employee-name');
                
                $('#currentAttendanceId').val(attendanceId);
                $('#newStatus').val(currentStatus);
                $('#editStatusModalBody').text(`Update the attendance status for ${employeeName}.`);
                $('#remarks').val('');
                
                $('#editStatusModal').modal('show');
            });

            // Confirm status update
            $('#confirmEditStatus').on('click', function () {
                const attendanceId = $('#currentAttendanceId').val();
                const newStatus = $('#newStatus').val();
                const remarks = $('#remarks').val();
                
                if (!attendanceId) {
                    showAlert('error', 'Attendance ID not found.');
                    return;
                }
                
                $.post('@Url.Action("UpdateStatus")', {
                    attendanceId: attendanceId,
                    status: newStatus,
                    remarks: remarks
                })
                .done(function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showAlert('error', response.message);
                    }
                })
                .fail(function () {
                    showAlert('error', 'An error occurred. Please try again.');
                })
                .always(function () {
                    $('#editStatusModal').modal('hide');
                });
            });

            function showAlert(type, message) {
                const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                
                const alertHtml = `
                    <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                
                // Insert alert at the top of the page
                $('.container-fluid').prepend(alertHtml);
                
                // Auto-remove after 5 seconds
                setTimeout(() => {
                    $('.alert').fadeOut();
                }, 5000);
            }
        });
    </script>
}

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .bg-gradient-info {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }
    
    .bg-gradient-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    }
    
    .bg-gradient-warning {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    }
    
    .bg-gradient-danger {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
    }
    
    .avatar-sm {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .btn-group .btn:last-child {
        margin-right: 0;
    }
</style>
